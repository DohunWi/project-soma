{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "history_sessions",
  "description": "GET /api/state/history/sessions. JWT sub의 사용자에 저장된 session 목록. first/last_measured_at은 snapshot 시각이며 실제 Start/Stop 시각이 아닙니다. NULL session_id인 legacy row는 제외합니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "status", "user_id", "sessions"],
  "properties": {
    "v": { "const": 1 },
    "status": { "const": "success" },
    "user_id": { "type": "string", "format": "uuid" },
    "sessions": {
      "type": "array",
      "description": "last_measured_at 내림차순, 동률이면 session_id 내림차순. 종료 여부는 snapshot만으로 추정하지 않습니다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "first_measured_at", "last_measured_at", "snapshot_count"],
        "properties": {
          "session_id": { "type": "string", "format": "uuid" },
          "first_measured_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
          "last_measured_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
          "snapshot_count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "examples": [{
    "v": 1, "status": "success", "user_id": "11111111-1111-4111-8111-111111111111",
    "sessions": [{
      "session_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "first_measured_at": "2026-10-14T03:00:00Z", "last_measured_at": "2026-10-14T03:05:00Z",
      "snapshot_count": 61
    }]
  }]
}
