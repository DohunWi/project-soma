{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "state_history",
  "description": "public.state_logs → Backend GET /api/state/history → Front. Front는 Supabase에 직접 접근하지 않습니다. 현재 state_logs.user_id가 NULL이므로 Demo 단계에서는 user_name + device_id를 임시 stream identifier로 사용하며, 향후 인증/user_id 연동 시 변경될 수 있습니다.",
  "type": "object",
  "required": ["v", "status", "stream", "period", "states"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "status": { "const": "success" },
    "stream": {
      "type": "object",
      "required": ["user_name", "device_id"],
      "additionalProperties": false,
      "properties": {
        "user_name": { "type": "string", "minLength": 1 },
        "device_id": { "type": "string", "minLength": 1 }
      }
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/utcTimestamp" },
        "end": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "baseline": {
      "description": "period.start 직전의 마지막 상태. 존재하지 않으면 키를 생략합니다.",
      "$ref": "#/$defs/snapshot"
    },
    "states": {
      "type": "array",
      "description": "period 안의 상태 snapshot을 measured_at 오름차순으로 반환합니다.",
      "items": { "$ref": "#/$defs/snapshot" }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$",
      "description": "UTC ISO 8601 timestamp"
    },
    "snapshot": {
      "type": "object",
      "required": ["measured_at", "state", "score", "confidence", "reasons"],
      "additionalProperties": false,
      "properties": {
        "measured_at": { "$ref": "#/$defs/utcTimestamp" },
        "state": { "enum": ["NORMAL", "CAUTION", "DANGER", "ABSENT"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": {
          "type": "array",
          "items": {
            "enum": ["low_blink", "close_distance", "imbalance", "static_hold", "no_backrest"]
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "balance": { "enum": ["LEFT", "CENTER", "RIGHT"] },
            "static_hold_sec": { "type": "number", "minimum": 0 },
            "low_blink_sec": { "type": "number", "minimum": 0 },
            "session_sec": { "type": "number", "minimum": 0 },
            "chair_distance_mm": { "type": "integer", "minimum": 0 },
            "blink_rate": { "type": "number", "minimum": 0 },
            "face_distance_cm": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    }
  }
}
