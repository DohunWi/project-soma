# 복사해서 .env 로 쓰세요.  .env 는 절대 커밋하지 않습니다.
#   cp .env.example .env

# ─── DB (Supabase) ────────────────────────────────────────────
# postgres 슈퍼유저를 쓰지 마세요. 앱 전용 롤을 만들어 쓰세요.
#
# ⚠ 직접 주소(db.<ref>.supabase.co)는 IPv6 레코드만 있습니다.
#   IPv6 가 안 되는 네트워크(학교 와이파이 등)에서는 연결이 안 됩니다.
#   IPv4 로 붙는 풀러 주소를 쓰세요. 사용자명 형식이 다릅니다.
#     DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
#     DB_PORT=6543
#     DB_USER=postgres.<project-ref>
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# 시연용 테이블을 따로 쓸 때만 (기본 sensor_logs)
DB_SENSOR_TABLE=

# ─── 서버 ─────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
# macOS 는 5000 번을 AirPlay 수신(ControlCenter)이 이미 쓰고 있습니다.
# 그대로 두면 "Address already in use" 로 서버가 뜨지 않습니다. 확인:
#     lsof -nP -iTCP:5000 -sTCP:LISTEN
# 시스템 설정에서 AirPlay 수신을 끄거나, 여기서 다른 포트를 쓰세요.
# 포트를 바꾸면 대시보드와 CORS_ALLOWED_ORIGINS 도 같이 맞춰야 합니다.
SERVER_PORT=5000
# socket 연결 시 요구할 토큰
SOCKET_AUTH_TOKEN=
# 운영에서는 '*' 를 쓰지 마세요
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500

# ─── 의자 ─────────────────────────────────────────────────────
# Windows: COM3 / macOS: /dev/tty.usbmodem*
CHAIR_SERIAL_PORT=
CHAIR_BAUD_RATE=9600

# ─── 웹캠 ─────────────────────────────────────────────────────
# 외부캠. 내장캠은 각도에 예민해 쓰지 않습니다
WEBCAM_INDEX=0

# 좌우 회전(yaw) 허용치. 이보다 돌아가면 그 프레임의 얼굴 폭을 신뢰하지 않습니다.
# 고개를 돌리면 얼굴 폭이 줄어 "멀어졌다" 고 오판하기 때문입니다.
# 거리는 홍채로 재므로 이 게이트의 영향이 줄었습니다 — 품질 지표로 남습니다.
VISION_YAW_MAX=0.22

# ─── 거리 스케일 ──────────────────────────────────────────────
# 거리는 홍채 지름(성인 11.7mm ± 0.5mm)을 자로 써서 잽니다.
# 개인 캘리브레이션이 필요 없고, 카메라마다 초점거리(px)만 정하면 됩니다.
#
#   VISION_FOCAL_PX     자로 한 번 재서 얻은 값. 가장 정확합니다.
#                       python vision/eval/distance_check.py --points 50 70
#   VISION_CAMERA_FOV_DEG  자가 없을 때. 가로 화각에서 유도합니다(기본 55).
#
# 이 값은 **카메라 고유값**이라 사람이 바뀌어도 유효합니다.
# 카메라를 바꾸면 다시 재세요.
VISION_FOCAL_PX=
VISION_CAMERA_FOV_DEG=55

# ─── 모니터 상단 LED ──────────────────────────────────────────
# 아두이노를 거치지 않습니다. 노트북에 직접 붙는 USB 장치입니다.
#   console     터미널에 그리기 (장치 없이 확인)
#   blinkstick  BlinkStick Flex/Strip — USB 어드레서블 LED
#   openrgb     이미 가진 RGB 키보드·스트립 (OpenRGB 앱의 SDK 서버 필요)
LED_BACKEND=console
LED_COUNT=32

# ─── 세션 ─────────────────────────────────────────────────────
# input() 프롬프트 대신 여기서 지정
USER_NAME=guest
