# 복사해서 .env 로 쓰세요.  .env 는 절대 커밋하지 않습니다.
#   cp .env.example .env

# ─── DB (Supabase) ────────────────────────────────────────────
# postgres 슈퍼유저를 쓰지 마세요. 앱 전용 롤을 만들어 쓰세요.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# ─── 서버 ─────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
# socket 연결 시 요구할 토큰
SOCKET_AUTH_TOKEN=
# 운영에서는 '*' 를 쓰지 마세요
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500

# ─── 의자 ─────────────────────────────────────────────────────
# Windows: COM3 / macOS: /dev/tty.usbmodem*
CHAIR_SERIAL_PORT=
CHAIR_BAUD_RATE=9600

# ─── 웹캠 ─────────────────────────────────────────────────────
# 외부캠. 내장캠은 각도에 예민해 쓰지 않습니다
WEBCAM_INDEX=0

# ─── 세션 ─────────────────────────────────────────────────────
# input() 프롬프트 대신 여기서 지정
USER_NAME=guest
